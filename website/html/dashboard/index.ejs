<!doctype html>
<html lang="en" data-bs-theme="dark">

<head>
  <%- include('partials/head', { title: 'Dashboard - Countic' }); %>
</head>

<body class="dash-body">
  <%- include('partials/header'); %>

  <main class="dash-main">
    <h1 class="h3 fw-bold mb-1">Your servers</h1>
    <p class="text-body-secondary mb-4">Servers where you have Manage Server permission. Pick one to manage its stat panels.</p>

    <div class="dash-guild-grid">
      <% guilds.forEach((entry) => { %>
      <a class="dash-guild-card" href="/dashboard/guilds/<%= entry.id %>">
        <% if (entry.icon) { %>
        <img src="<%= entry.icon %>" width="40" height="40" alt="">
        <% } else { %>
        <span class="dash-initial" aria-hidden="true"><%= entry.initial %></span>
        <% } %>
        <span class="dash-guild-name"><%= entry.name %></span>
      </a>
      <% }); %>

      <% if (guilds.length === 0) { %>
      <div class="dash-empty">
        <img src="/img/logo.svg" width="44" height="44" alt="">
        <p class="mt-3 mb-2">No servers where you have Manage Server permission.</p>
        <a class="btn btn-discord" href="/add">Invite Countic</a>
        <p class="text-body-secondary small mt-3 mb-0">Servers appear here once Countic was added to one you manage.</p>
      </div>
      <% } %>
    </div>
  </main>

  <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>

</html>
