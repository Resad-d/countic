<header class="d-flex flex-column flex-md-row align-items-center justify-content-between py-2 px-2 px-md-4 sticky-top site-header">
  <div class="text-center text-md-start mb-2 mb-md-0">
    <a href="/" class="link-body-emphasis text-decoration-none h3 m-0 d-inline-flex align-items-center gap-2">
      <img src="/img/logo.svg" width="30" height="30" alt="">
      <span class="brand-word">Countic</span>
    </a>
  </div>

  <nav class="my-2 my-md-0">
    <ul class="nav site-nav flex-wrap flex-md-nowrap justify-content-center gap-2 gap-md-3">
      <li class="nav-item"><a href="/" class="nav-link fw-bold <%= active === 'home' ? 'active' : '' %>">Home</a></li>
      <li class="nav-item"><a href="/commands" class="nav-link fw-bold <%= active === 'commands' ? 'active' : '' %>">Commands</a></li>
      <li class="nav-item"><a href="/guide" class="nav-link fw-bold <%= active === 'guide' ? 'active' : '' %>">Guides</a></li>

      <li class="nav-item"><a href="/faqs" class="nav-link fw-bold <%= active === 'faqs' ? 'active' : '' %>">FAQs</a></li>
      <li class="nav-item"><a href="/about" class="nav-link fw-bold <%= active === 'about' ? 'active' : '' %>">About</a></li>
    </ul>
  </nav>

  <div class="text-center text-md-end">
    <% if (user) { %>
    <div class="dropdown">
      <button type="button" class="btn p-0 border-0" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        <img src="<%= user.avatarUrl %>" width="40" height="40" class="rounded-circle" alt="User avatar">
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <h6 class="dropdown-header fw-bold"><%= user.username %></h6>
        </li>
        <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
        <li><a class="dropdown-item" href="/guide">Guides</a></li>
        <li>
          <hr class="dropdown-divider">
        </li>
        <li><a class="dropdown-item text-danger" href="/logout">Log out</a></li>
      </ul>
    </div>
    <% } else { %>
    <a href="/login?return=<%= encodeURIComponent(currentPath) %>" class="btn btn-discord">Login</a>
    <% } %>
  </div>
</header>
