# runtime
NODE_ENV=development
LOG_LEVEL=info

# database
# DATABASE_URL is only read outside Docker.
# Compose reads COUNTIC_PG_PASSWORD and builds its own URL.
DATABASE_URL=postgres://countic:countic@localhost:5432/countic
COUNTIC_PG_PASSWORD=countic

# web
WEB_PORT=3000

# metrics
METRICS_ENABLED=true
METRICS_PORT=9101

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# admin suite
DISCORD_ADMIN_GUILD_ID=
DISCORD_OWNER_ID=

# platform data sources
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# scheduler and quota, defaults shown, only set to override
# YOUTUBE_REFRESH_CADENCE_MINUTES=60
# TWITCH_REFRESH_CADENCE_MINUTES=15
# KICK_REFRESH_CADENCE_MINUTES=15
# SCHEDULER_TICK_SECONDS=60
# SCHEDULER_MAX_PANELS_PER_TICK=200
# YOUTUBE_QUOTA_BUDGET=8000
# YOUTUBE_REFRESH_POOL=7000
# YOUTUBE_RESOLUTION_RESERVE=1000
# RESOLUTION_DAILY_PER_GUILD=50
# COMMAND_LOG_RETENTION_DAYS=90
