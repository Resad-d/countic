# runtime
NODE_ENV=development
LOG_LEVEL=info

# database
# DATABASE_URL is only read outside Docker.
# Compose reads COUNTIC_PG_PASSWORD and builds its own URL.
DATABASE_URL=postgres://countic:countic@localhost:5432/countic
COUNTIC_PG_PASSWORD=countic

# web
WEB_PORT=3000

# metrics
METRICS_ENABLED=true
METRICS_PORT=9101

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
